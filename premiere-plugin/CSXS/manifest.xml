<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.stemtool.premiere" ExtensionBundleVersion="0.10.0"
  ExtensionBundleName="StemTool Audio Splitter" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.stemtool.premiere.panel" Version="0.10.0" />
  </ExtensionList>
  <HostList>
    <!-- Premiere Pro support from CC 2020 (14.0) through 2025+ (99.9) -->
    <Host Name="PPRO" Version="[14.0,99.9]" />
  </HostList>
  <DispatchInfoList>
    <Extension Id="com.stemtool.premiere.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/Premiere.jsx</ScriptPath>
          <CEPEngine>
            <CommandLine>
              <Parameter>--enable-nodejs</Parameter>
              <Parameter>--mixed-context</Parameter>
            </CommandLine>
          </CEPEngine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>StemTool Audio Splitter</Menu>
          <Geometry>
            <Size>
              <Height>580</Height>
              <Width>360</Width>
            </Size>
            <MinSize>
              <Height>380</Height>
              <Width>300</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>

